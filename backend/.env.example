# 数据库
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading_workbench

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 事件驱动执行（docs/06 A3，2026-10-21 生产已打开）：user-data-stream 成交事件
# 秒级触发结算（移保本/移动止损）+ 挂单成交落地；与 30min 巡检双入口幂等，
# 巡检保留兜底。默认关（ False=纯定时巡检）；打开前建议先测试网观察 ≥24h
# 系统日志出现「事件触发结算/挂单落地」且无误动作
EVENT_EXEC_ENABLED=true

# 币安
# 行情 REST 基地址（binance_client.py K线/成交额用；与下单基地址无关）
BINANCE_BASE_URL=https://api.binance.com
# 合约 REST 基地址（行情侧备用；下单基地址由账号 testnet 属性决定，见 binance_trader.py）
BINANCE_FUTURES_URL=https://fapi.binance.com

# 扫描策略
SCAN_INTERVAL_HOURS=1
KLINE_INTERVAL=1h
KLINE_WINDOW=240
BREAKOUT_THRESHOLD=0.002
R_SQUARED_THRESHOLD=0.5
REPEAT_WINDOW_HOURS=3
# 扫描候选池 24h 成交额下限（USDT），低于此不进扫描（省K线请求）
MIN_VOLUME_24H=3000000

# AI 分析（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 飞书通知统一走自建应用机器人（日报/持仓建议/平仓结果；四项都配置才启用，webhook 已弃用）
# TARGET_ID=个人 open_id（ou_ 开头，机器人私聊）或群 chat_id（oc_ 开头），按前缀自动识别
# ACTION_TOKEN=按钮回调校验令牌（随机生成，如 python3 -c "import secrets; print(secrets.token_hex(16))"）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_ID=
FEISHU_ACTION_TOKEN=

# LLM 全局并发上限（Redis 信号量）与单次调用超时（秒）
LLM_CONCURRENCY=4
AI_CALL_TIMEOUT_S=240
# 单次扫描批量 AI 分析上限（按24h成交额取前N）
AI_MAX_PER_SCAN=10

# ===== 自动交易（docs/06，币安 USDT-M 合约）=====
# 正式网账号命名统一为 BINANCE_LIVE_{N}_*（N 从 1 递增、数量不限）→ 账号 key live-N；
# NAME 可选，缺省「正式网-N」。启用哪些账号自动交易在页面「系统配置」弹窗选择。
# 向后兼容：live-1 未配置 LIVE_1 写法时回落旧变量 BINANCE_API_KEY/SECRET_KEY
# （代码保留兼容旧部署，示例不再列出；两处都配时 LIVE_1 优先）
BINANCE_LIVE_1_API_KEY=
BINANCE_LIVE_1_SECRET_KEY=
# BINANCE_LIVE_1_NAME=主账号
BINANCE_LIVE_2_API_KEY=
BINANCE_LIVE_2_SECRET_KEY=
# BINANCE_LIVE_2_NAME=仓位B
# 旧变量（live-1 兼容回落，代码保留；新部署统一用 LIVE_1 命名即可）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# 现货测试网专用 key（可选，2026-09-24）：现货测试网（testnet.binance.vision）与
# 合约测试网（testnet.binancefuture.com）是两套独立系统，key 不互通——
# 同一把 key 合约侧正常、现货侧 401。未配置时回落 BINANCE_TESTNET_*（但该回落值
# 在现货侧通常无效），使用现货功能请到 testnet.binance.vision 单独生成
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_SECRET_KEY=
# 初始总开关（2026-09-20 起迁移进 system_config 表，页面可改、任务即时生效）：
# - TRADING_ENABLED=false 自动交易总开关关闭（2026-10-03 起由页面双网独立开关
#   接管：测试网默认开/正式网默认关，TRADING_TESTNET 环境切换已废弃删除）
# 此处仅首次建行注入初始值；运行时以 system_config 双开关为准
TRADING_ENABLED=false
# 开单推荐度门槛（AI 评分 >= 此值才允许开单）
TRADING_MIN_RECOMMENDATION=60
# 止损金额占风险基数比例（%）：仓位 = 基数×3% ÷ 止损距离%
TRADING_RISK_PCT=3.0
# 可用余额/总资金低于此比例停止开新仓。
# 注意：实际生效值是数据库 system_config.trading_min_free_pct（页面「开仓最低可用余额」可改），
# 此值仅在缺列/缺行时兜底（2026-09-15 由 70% 改 50%）
TRADING_MIN_FREE_PCT=0.5
# 杠杆倍数上限（逐仓 ISOLATED；止损距离超强平闸门时动态下调）
TRADING_LEVERAGE=20
# 动态杠杆下限默认值（system_config.min_adapt_leverage 可页面覆盖）：
# 安全杠杆低于下限的宽止损单放弃，不是所有单都算完就开
TRADING_LEVERAGE_MIN=8
