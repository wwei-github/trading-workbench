# 数据库
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading_workbench

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 币安
BINANCE_BASE_URL=https://api.binance.com
# 实时K线推送（KlineHub，docs/05）；连不上时自动降级 REST 轮询
BINANCE_WS_URL=wss://fstream.binance.com

# 扫描策略
SCAN_INTERVAL_HOURS=1
KLINE_INTERVAL=1d
KLINE_WINDOW=120
BREAKOUT_THRESHOLD=0.01
R_SQUARED_THRESHOLD=0.5
REPEAT_WINDOW_HOURS=24

# AI 分析（OpenAI 兼容接口）
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== 自动交易（docs/06，币安 USDT-M 合约）=====
# 交易专用 API key（需开启合约交易权限；不要复用只读行情 key）
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# 首期走 testnet 验证链路（https://testnet.binancefuture.com）；实盘改 false
TRADING_TESTNET=true
# 自动交易总开关（false 时每小时任务直接跳过）
TRADING_ENABLED=false
# 开单推荐度门槛（AI 评分 >= 此值才允许开单）
TRADING_MIN_RECOMMENDATION=60
# 止损金额占风险基数比例（%）：仓位 = 基数×3% ÷ 止损距离%
TRADING_RISK_PCT=3.0
# 风险基数分档（钱包余额向下落档：100~200 刀按 100 刀的 3% = 3 刀）
TRADING_CAPITAL_TIERS=100,200,500,1000,2000,5000,10000
# 可用余额/总资金低于此比例停止开新仓（70% 规则）
TRADING_MIN_FREE_PCT=0.7
# 杠杆倍数（逐仓 ISOLATED）
TRADING_LEVERAGE=20
