# 数据库
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading_workbench

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 币安
# 行情 REST 基地址（binance_client.py K线/成交额用；与下单环境的 TRADING_TESTNET 切换无关）
BINANCE_BASE_URL=https://api.binance.com
# 合约 REST 基地址（行情侧备用；下单基地址由 TRADING_TESTNET 决定，见 binance_trader.py）
BINANCE_FUTURES_URL=https://fapi.binance.com

# 扫描策略
SCAN_INTERVAL_HOURS=1
KLINE_INTERVAL=1h
KLINE_WINDOW=240
BREAKOUT_THRESHOLD=0.005
R_SQUARED_THRESHOLD=0.5
REPEAT_WINDOW_HOURS=3
# 扫描候选池 24h 成交额下限（USDT），低于此不进扫描（省K线请求）
MIN_VOLUME_24H=3000000

# AI 分析（OpenAI 兼容接口）
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 飞书群机器人（每日 08:05 业务日报；未配置时通知静默跳过）
FEISHU_NOTIFY_WEBHOOK=

# LLM 全局并发上限（Redis 信号量）与单次调用超时（秒）
LLM_CONCURRENCY=4
AI_CALL_TIMEOUT_S=240
# 单次扫描批量 AI 分析上限（按24h成交额取前N）
AI_MAX_PER_SCAN=10

# ===== 自动交易（docs/06，币安 USDT-M 合约）=====
# 双环境凭据：正式网 key（即下方 BINANCE_API_KEY/SECRET_KEY）；
# 测试网 key 可单独配置（未配置时回落正式网 key，兼容只有一组 key 的部署）。
# 凭据只在 .env 配置（安全不入库）；页面「系统配置」弹窗只显示已配置/未配置状态。
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# 初始交易环境与总开关（2026-09-20 起迁移进 system_config 表，页面可改、任务即时生效）：
# - TRADING_TESTNET=true 走测试网（https://testnet.binancefuture.com），false 走正式网
# - TRADING_ENABLED=false 自动交易总开关关闭（停开新单，结算巡检照常）
# 此处仅首次建行注入初始值；运行时以 system_config.trading_testnet/trading_enabled 为准
TRADING_TESTNET=true
TRADING_ENABLED=false
# 开单推荐度门槛（AI 评分 >= 此值才允许开单）
TRADING_MIN_RECOMMENDATION=60
# 止损金额占风险基数比例（%）：仓位 = 基数×3% ÷ 止损距离%
TRADING_RISK_PCT=3.0
# 风险基数分档（钱包余额向下落档：100~200 刀按 100 刀的 3% = 3 刀）
TRADING_CAPITAL_TIERS=100,200,500,1000,2000,5000,10000
# 可用余额/总资金低于此比例停止开新仓。
# 注意：实际生效值是数据库 system_config.trading_min_free_pct（页面「开仓最低可用余额」可改），
# 此值仅在缺列/缺行时兜底（2026-09-15 由 70% 改 50%）
TRADING_MIN_FREE_PCT=0.5
# 杠杆倍数上限（逐仓 ISOLATED；止损距离超强平闸门时动态下调）
TRADING_LEVERAGE=20
# 动态杠杆下限默认值（system_config.min_adapt_leverage 可页面覆盖）：
# 安全杠杆低于下限的宽止损单放弃，不是所有单都算完就开
TRADING_LEVERAGE_MIN=8
